# Google Cloud identifiers for y-swim.com (not secrets: names and IDs only).
# Filled in from the output of infra/gcp/bootstrap.sh. Read by .github/workflows/deploy-cloud-run.yml;
# until GCP_PROJECT_ID is set, merges to main skip the Cloud Run deploy.
GCP_PROJECT_ID=pentathlon-records
GCP_REGION=us-east4
GCP_WIF_PROVIDER=projects/38587053372/locations/global/workloadIdentityPools/github/providers/github-actions
GCP_DEPLOYER_SA=yswim-deployer@pentathlon-records.iam.gserviceaccount.com
GCP_RUNTIME_SA=yswim-run@pentathlon-records.iam.gserviceaccount.com
