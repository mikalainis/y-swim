# Google Cloud identifiers for y-swim.com (not secrets: names and IDs only).
# Filled in from the output of infra/gcp/bootstrap.sh. Read by .github/workflows/deploy-cloud-run.yml;
# until GCP_PROJECT_ID is set, merges to main skip the Cloud Run deploy.
GCP_PROJECT_ID=
GCP_REGION=
GCP_WIF_PROVIDER=
GCP_DEPLOYER_SA=
GCP_RUNTIME_SA=
